// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             Int             @id @default(autoincrement())
  publicId       String          @unique @default(cuid())
  email          String          @unique
  firstName      String
  lastName       String
  password       String
  role           Role            @default(STUDENT)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  teacherClasses TeacherClass[]
}

model TeacherClass {
  id             Int             @id @default(autoincrement())
  publicId       String          @unique @default(cuid())
  name           String
  subject        String?
  section        String?
  semester       String?
  programCode    String?
  programName    String?
  courseCode     String?
  courseName     String?
  semesterNumber Int?
  courseCatalogId Int?
  teacherId      Int
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  teacher        User            @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  courseCatalog  CourseCatalog?  @relation(fields: [courseCatalogId], references: [id], onDelete: SetNull)
  students       StudentRecord[]
  predictions    PredictionRun[]

  @@index([teacherId])
  @@index([programCode, semesterNumber])
  @@index([programCode, courseCode])
  @@index([courseCatalogId])
}

model CourseCatalog {
  id             Int           @id @default(autoincrement())
  publicId       String        @unique @default(cuid())
  programCode    ProgramCode
  semesterNumber Int
  courseCode     String
  courseTitle    String
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  classes        TeacherClass[]

  @@unique([programCode, semesterNumber, courseCode])
  @@index([programCode, semesterNumber])
}

model AcademicProgram {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model StudentRecord {
  id                   Int               @id @default(autoincrement())
  publicId             String            @unique @default(cuid())
  classId              Int
  name                 String
  regNo                String
  email                String?
  phoneNumber          String?
  address              String?
  expectedCgpa         Float?
  overallRiskLevel     RiskLevel?
  classRank            Int?
  semesterAvgScore     Float?
  quiz1                Float?
  quiz2                Float?
  quiz3                Float?
  quiz4                Float?
  quiz5                Float?
  quiz6                Float?
  assignment1          Float?
  assignment2          Float?
  assignment3          Float?
  assignment4          Float?
  assignment5          Float?
  midsPercentage       Float?
  attendancePercentage Float?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  class                TeacherClass      @relation(fields: [classId], references: [id], onDelete: Cascade)
  predictionEntries    PredictionEntry[]

  @@unique([classId, regNo])
  @@index([classId])
}

model PredictionRun {
  id              Int             @id @default(autoincrement())
  publicId        String          @unique @default(cuid())
  reportCode      String?         @unique
  classId         Int
  title           String
  scope           PredictionScope
  programCode     String?
  semesterNumber  Int?
  section         String?
  courseCode      String?
  courseName      String?
  generatedAt     DateTime        @default(now())
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  class           TeacherClass    @relation(fields: [classId], references: [id], onDelete: Cascade)
  entries         PredictionEntry[]

  @@index([classId])
  @@index([programCode, semesterNumber])
  @@index([courseCode])
}

model PredictionEntry {
  id              Int              @id @default(autoincrement())
  publicId        String           @unique @default(cuid())
  predictionRunId Int
  studentRecordId Int?
  studentName     String
  regNo           String
  predictedScore  Float
  performance     PerformanceLevel
  passProbability Float
  modelConfidence Float
  riskLevel       RiskLevel
  suggestions     Json
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  predictionRun   PredictionRun    @relation(fields: [predictionRunId], references: [id], onDelete: Cascade)
  studentRecord   StudentRecord?   @relation(fields: [studentRecordId], references: [id], onDelete: SetNull)

  @@unique([predictionRunId, regNo])
  @@index([predictionRunId])
  @@index([studentRecordId])
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum PredictionScope {
  CLASS
  SELECTED
}

enum PerformanceLevel {
  LOW
  AVG
  HIGH
}

enum RiskLevel {
  LOW
  MID
  HIGH
}

enum ProgramCode {
  BSCS
  BSSE
}