// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             Int             @id @default(autoincrement())
  publicId       String          @unique @default(cuid())
  email          String          @unique
  firstName      String
  lastName       String
  password       String
  role           Role            @default(STUDENT)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  teacherClasses TeacherClass[]
}

model TeacherClass {
  id          Int             @id @default(autoincrement())
  publicId    String          @unique @default(cuid())
  name        String
  code        String?
  section     String?
  semester    String?
  teacherId   Int
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  teacher     User            @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  students    StudentRecord[]
  predictions PredictionRun[]

  @@index([teacherId])
}

model StudentRecord {
  id                   Int               @id @default(autoincrement())
  publicId             String            @unique @default(cuid())
  classId              Int
  name                 String
  regNo                String
  quiz1                Float?
  quiz2                Float?
  quiz3                Float?
  quiz4                Float?
  quiz5                Float?
  quiz6                Float?
  assignment1          Float?
  assignment2          Float?
  assignment3          Float?
  assignment4          Float?
  assignment5          Float?
  midsPercentage       Float?
  attendancePercentage Float?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  class                TeacherClass      @relation(fields: [classId], references: [id], onDelete: Cascade)
  predictionEntries    PredictionEntry[]

  @@unique([classId, regNo])
  @@index([classId])
}

model PredictionRun {
  id          Int             @id @default(autoincrement())
  publicId    String          @unique @default(cuid())
  reportCode  String?         @unique
  classId     Int
  title       String
  scope       PredictionScope
  generatedAt DateTime        @default(now())
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  class       TeacherClass    @relation(fields: [classId], references: [id], onDelete: Cascade)
  entries     PredictionEntry[]

  @@index([classId])
}

model PredictionEntry {
  id              Int              @id @default(autoincrement())
  publicId        String           @unique @default(cuid())
  predictionRunId Int
  studentRecordId Int?
  studentName     String
  regNo           String
  predictedScore  Float
  performance     PerformanceLevel
  passProbability Float
  modelConfidence Float
  riskLevel       RiskLevel
  suggestions     Json
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  predictionRun   PredictionRun    @relation(fields: [predictionRunId], references: [id], onDelete: Cascade)
  studentRecord   StudentRecord?   @relation(fields: [studentRecordId], references: [id], onDelete: SetNull)

  @@unique([predictionRunId, regNo])
  @@index([predictionRunId])
  @@index([studentRecordId])
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum PredictionScope {
  CLASS
  SELECTED
}

enum PerformanceLevel {
  LOW
  AVG
  HIGH
}

enum RiskLevel {
  LOW
  MID
  HIGH
}